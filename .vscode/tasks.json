				"exec",
				"app",
				"printenv",
				"DATABASE_URL"
			],
			"isBackground": false
		},
		{
			"label": "Inspect app database URL",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"--env-file",
				".env.example",
				"exec",
				"app",
				"printenv",
				"DATABASE_URL"
			],
			"isBackground": false
		},

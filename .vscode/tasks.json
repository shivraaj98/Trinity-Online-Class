				"README.md",
				"docker-compose.yml",
				"next.config.ts"
			],
			"isBackground": false
		},
		{
			"label": "Commit Docker hosting setup",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"README.md",
				"docker-compose.yml",
				"next.config.ts",
				".dockerignore",
				"Dockerfile",
				"public/.gitkeep"
			],
			"isBackground": false
		},
		{
			"label": "Commit Docker production stack",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Add Docker production hosting stack"
			],
			"isBackground": false
		},
		{
			"label": "Confirm repository state",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false
		},
		{
			"label": "Inspect platform files",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-ChildItem -Recurse -File -Exclude node_modules | Select-Object FullName,Length | Format-Table -AutoSize"
			],
			"isBackground": false
		},
		{
			"label": "Inspect application routes",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Content -LiteralPath 'prisma/schema.prisma'; Get-Content -LiteralPath 'src/app/dashboard/page.tsx'; Get-Content -LiteralPath 'src/app/teacher/page.tsx'; Get-Content -LiteralPath 'src/app/admin/page.tsx'; Get-Content -LiteralPath 'src/app/api/courses/route.ts'; Get-Content -LiteralPath 'src/app/api/enrollments/route.ts'"
			],
			"isBackground": false
		},
		{
			"label": "Inspect auth and seed config",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Content -LiteralPath 'src/lib/auth.ts'; Get-Content -LiteralPath 'prisma/seed.ts'; Get-Content -LiteralPath 'package.json'; Get-Content -LiteralPath '.env.example'"
			],
			"isBackground": false
		},
		{
			"label": "Inspect course experience",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Content -LiteralPath 'src/app/explore/page.tsx'; Get-Content -LiteralPath 'src/app/login/page.tsx'; Get-Content -LiteralPath 'src/app/page.tsx'"
			],
			"isBackground": false
		},
		{
			"label": "Check Docker Desktop",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"$cmd = Get-Command docker -ErrorAction SilentlyContinue; $procs = Get-Process -Name 'Docker Desktop' -ErrorAction SilentlyContinue; [pscustomobject]@{Docker=$cmd.Source; DockerDesktopRunning=[bool]$procs} | Format-List"
			],
			"isBackground": false
		},
		{
			"label": "Check Docker engine",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Start-Sleep -Seconds 10; docker info --format '{{.ServerVersion}}'"
			],
			"isBackground": false
		},
		{
			"label": "Check Docker engine status",
			"type": "shell",
			"command": "docker",
			"args": [
				"info",
				"--format",
				"{{.ServerVersion}}"
			],
			"isBackground": false
		},
		{
			"label": "Check Docker engine details",
			"type": "shell",
			"command": "docker",
			"args": [
				"info"
			],
			"isBackground": false
		},

			"label": "Review Docker changes",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false
		},
		{
			"label": "Inspect pending changes",
			"type": "shell",
			"command": "git",
			"args": [
				"diff",
				"--stat",
				"--",

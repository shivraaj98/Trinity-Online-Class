			"label": "Inspect Docker environment files",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Content -LiteralPath 'docker-compose.yml'; Get-Content -LiteralPath '.env.example'"
			],
			"isBackground": false
		},

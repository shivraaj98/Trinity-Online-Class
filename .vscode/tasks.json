				"--env-file",
				".env.example",
				"config"
			],
			"isBackground": false
		},
		{
			"label": "Build Docker image",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"--env-file",
				".env.example",
				"build"
			],
			"isBackground": false
		},

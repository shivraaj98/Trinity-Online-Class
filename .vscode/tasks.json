{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Trinity Classes dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Trinity Classes production app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Rebuild Trinity Classes production app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Trinity Classes production app after schema fix",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final production build for Trinity Classes",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Initialize Trinity Classes repository",
			"type": "shell",
			"command": "git",
			"args": [
				"init"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Build production learning platform"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Allow Trinity Classes repository for Git",
			"type": "shell",
			"command": "git",
			"args": [
				"config",
				"--global",
				"--add",
				"safe.directory",
				"D:/shiv/New folder/Trinity Classes"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage Trinity Classes source retry",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage tracked Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"--all"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}
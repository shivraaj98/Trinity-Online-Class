			"label": "Synchronize local database password",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"--env-file",
				".env.example",
				"exec",
				"postgres",
				"psql",
				"-U",
				"postgres",
				"-d",
				"trinity_classes",
				"-c",
				"ALTER USER postgres PASSWORD 'postgres';"
			],
			"isBackground": false
		},
		{
			"label": "Restart Trinity app container",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"--env-file",
				".env.example",
				"restart",
				"app"
			],
			"isBackground": false
		},
		{
			"label": "Verify database credentials",
			"type": "shell",
			"command": "docker",
			"args": [
				"run",
				"--rm",
				"--network",
				"trinityclasses_default",
				"-e",
				"PGPASSWORD=postgres",
				"postgres:16-alpine",
				"psql",
				"-h",
				"postgres",
				"-U",
				"postgres",
				"-d",
				"trinity_classes",
				"-c",
				"select 1"
			],
			"isBackground": false
		},
		{
			"label": "Set local database password",
			"type": "shell",
			"command": "docker compose --env-file .env.example exec -T postgres psql -U postgres -d trinity_classes -c \"ALTER USER postgres PASSWORD 'postgres';\"",
			"isBackground": false
		},
		{
			"label": "Set local database password safely",
			"type": "shell",
			"command": "docker compose --env-file .env.example exec -T postgres psql -U postgres -d trinity_classes -c 'ALTER USER postgres PASSWORD $$postgres$$;'",
			"isBackground": false
		},
		{
			"label": "Restart app after database fix",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"--env-file",
				".env.example",
				"restart",
				"app"
			],
			"isBackground": false
		},
		{
			"label": "Build complete Trinity platform",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Rebuild complete Trinity platform",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Run complete Trinity Docker platform",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"--env-file",
				".env.example",
				"up",
				"-d",
				"--build",
				"app"
			],
			"isBackground": false
		},
		{
			"label": "Align local database with production template",
			"type": "shell",
			"command": "docker compose --env-file .env.example exec -T postgres psql -U postgres -d trinity_classes -c 'ALTER USER postgres PASSWORD $$replace-with-a-strong-database-password$$;'",
			"isBackground": false
		},

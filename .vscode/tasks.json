{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install Trinity Classes dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Trinity Classes production app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Rebuild Trinity Classes production app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Trinity Classes production app after schema fix",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Final production build for Trinity Classes",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Initialize Trinity Classes repository",
			"type": "shell",
			"command": "git",
			"args": [
				"init"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Build production learning platform"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Allow Trinity Classes repository for Git",
			"type": "shell",
			"command": "git",
			"args": [
				"config",
				"--global",
				"--add",
				"safe.directory",
				"D:/shiv/New folder/Trinity Classes"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage Trinity Classes source retry",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"."
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage tracked Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"--all"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Commit deployable Trinity Classes source",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Build production learning platform"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove generated dependencies from Git index",
			"type": "shell",
			"command": "git",
			"args": [
				"rm",
				"-r",
				"--cached",
				"node_modules"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Amend clean Trinity Classes commit",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"--amend",
				"--no-edit"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Remove build output from Git index",
			"type": "shell",
			"command": "git",
			"args": [
				"rm",
				"-r",
				"--cached",
				".next"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Amend clean production source commit",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"--amend",
				"--no-edit"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install email authentication dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build email-auth Trinity Classes app",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Start local Trinity PostgreSQL server",
			"type": "shell",
			"command": "docker",
			"args": [
				"compose",
				"up",
				"-d",
				"postgres"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Stage email database authentication changes",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"--all"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}